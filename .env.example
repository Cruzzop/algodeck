# Copy this file to .env, then fill in what you need.
# Local SQLite database. Relative paths resolve from the prisma/ folder.
DATABASE_URL="file:./dev.db"

# AI works out of the box with a keyless free provider. Optional upgrade:
# add a free OpenRouter key from https://openrouter.ai/keys for better quality
# and higher limits (no card or credits needed).
OPENROUTER_API_KEY=""

# Keyless free AI is on by default. Set to "false" only if you want AI off
# unless an OpenRouter key is configured.
AI_KEYLESS_FALLBACK="true"

# Optional: pin one model first. Free models must end with ":free".
# OPENROUTER_MODEL=""

# Optional: public URL of your deployment, sent to OpenRouter for attribution.
# APP_URL="http://localhost:3000"
